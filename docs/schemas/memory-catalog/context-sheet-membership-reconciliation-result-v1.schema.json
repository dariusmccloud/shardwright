{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shardwright:schema:v1:context-sheet-membership-reconciliation-result-v1",
  "title": "ContextSheetMembershipReconciliationResultV1",
  "description": "Disposable replay-derived diagnostic result for Context Sheet membership history. It may authorize only projection rebuild or quarantine; it cannot infer, repair, or mutate membership, catalog, or Context Sheet authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope", "targetBoundary", "targetId", "reconciliationState", "authoritativeInputRefs",
    "observedProjectionRefs", "replayStages", "replayThroughEventRef", "reconstructedCounts",
    "discrepancies", "permittedAction", "authorityMutationPermitted", "authorityInferencePermitted",
    "linkAuthorityRepairPermitted", "unaffectedScopesRemainAvailable", "reconciledAt"
  ],
  "properties": {
    "envelope": {
      "allOf": [
        { "$ref": "urn:shardwright:schema:v1:memory-artifact-envelope-v1" },
        {
          "type": "object",
          "properties": {
            "artifactClass": { "const": "RESULT" },
            "schemaId": { "const": "context-sheet-membership-reconciliation-result-v1" }
          },
          "required": ["artifactClass", "schemaId"]
        }
      ]
    },
    "targetBoundary": { "enum": ["MEMBERSHIP_SCOPE", "MEMBERSHIP_LINK", "CONTEXT_SHEET_MEMBERSHIP"] },
    "targetId": { "type": "string", "minLength": 1 },
    "reconciliationState": {
      "enum": ["CLEAN", "REBUILD_REQUIRED", "AUTHORITY_MISSING", "CONFLICT", "INCOMPATIBLE_EVENT", "QUARANTINED"]
    },
    "authoritativeInputRefs": {
      "type": "array", "uniqueItems": true,
      "items": {
        "allOf": [
          { "$ref": "urn:shardwright:schema:v1:memory-artifact-reference-v1" },
          { "type": "object", "properties": { "expectedArtifactClass": { "enum": ["IMMUTABLE_RECORD", "EVENT", "AUTHORITY_REGISTRATION", "NOMINATION"] }, "resolutionRequirement": { "const": "EXACT_HASH" } } }
        ]
      }
    },
    "observedProjectionRefs": {
      "type": "array", "uniqueItems": true,
      "items": {
        "allOf": [
          { "$ref": "urn:shardwright:schema:v1:memory-artifact-reference-v1" },
          { "type": "object", "properties": { "expectedArtifactClass": { "const": "PROJECTION" }, "resolutionRequirement": { "const": "EXACT_HASH" } } }
        ]
      }
    },
    "replayStages": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog", "contextSheets", "nominations", "validationEvents", "successorEvents", "impactDecisions"],
      "properties": {
        "catalog": { "enum": ["COMPLETED", "NOT_RUN", "FAILED"] },
        "contextSheets": { "enum": ["COMPLETED", "NOT_RUN", "FAILED"] },
        "nominations": { "enum": ["COMPLETED", "NOT_RUN", "FAILED"] },
        "validationEvents": { "enum": ["COMPLETED", "NOT_RUN", "FAILED"] },
        "successorEvents": { "enum": ["COMPLETED", "NOT_RUN", "FAILED"] },
        "impactDecisions": { "enum": ["COMPLETED", "NOT_RUN", "FAILED"] }
      }
    },
    "replayThroughEventRef": {
      "allOf": [
        { "$ref": "urn:shardwright:schema:v1:memory-artifact-reference-v1" },
        { "type": "object", "properties": { "expectedArtifactClass": { "const": "EVENT" }, "resolutionRequirement": { "const": "EXACT_HASH" } } }
      ]
    },
    "reconstructedCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["nominations", "validationEvents", "acceptedLinks", "refusedDecisions", "successorEvents", "impactDecisions", "quarantinedItems"],
      "properties": {
        "nominations": { "type": "integer", "minimum": 0 },
        "validationEvents": { "type": "integer", "minimum": 0 },
        "acceptedLinks": { "type": "integer", "minimum": 0 },
        "refusedDecisions": { "type": "integer", "minimum": 0 },
        "successorEvents": { "type": "integer", "minimum": 0 },
        "impactDecisions": { "type": "integer", "minimum": 0 },
        "quarantinedItems": { "type": "integer", "minimum": 0 }
      }
    },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "severity", "message", "affectedRefs"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "severity": { "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"] },
          "message": { "type": "string", "minLength": 1 },
          "affectedRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:shardwright:schema:v1:memory-artifact-reference-v1" } }
        }
      }
    },
    "permittedAction": { "enum": ["NONE", "REBUILD_PROJECTION", "QUARANTINE"] },
    "authorityMutationPermitted": { "const": false },
    "authorityInferencePermitted": { "const": false },
    "linkAuthorityRepairPermitted": { "const": false },
    "unaffectedScopesRemainAvailable": { "type": "boolean" },
    "reconciledAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "reconciliationState": { "const": "CLEAN" } }, "required": ["reconciliationState"] },
      "then": {
        "properties": {
          "authoritativeInputRefs": { "type": "array", "minItems": 1 },
          "replayStages": { "type": "object", "properties": { "catalog": { "const": "COMPLETED" }, "contextSheets": { "const": "COMPLETED" }, "nominations": { "const": "COMPLETED" }, "validationEvents": { "const": "COMPLETED" }, "successorEvents": { "const": "COMPLETED" }, "impactDecisions": { "const": "COMPLETED" } } },
          "discrepancies": { "type": "array", "maxItems": 0 }, "permittedAction": { "const": "NONE" }
        }
      }
    },
    {
      "if": { "properties": { "reconciliationState": { "const": "REBUILD_REQUIRED" } }, "required": ["reconciliationState"] },
      "then": { "properties": { "authoritativeInputRefs": { "type": "array", "minItems": 1 }, "discrepancies": { "type": "array", "minItems": 1 }, "permittedAction": { "const": "REBUILD_PROJECTION" } } }
    },
    {
      "if": { "properties": { "reconciliationState": { "enum": ["AUTHORITY_MISSING", "CONFLICT", "INCOMPATIBLE_EVENT", "QUARANTINED"] } }, "required": ["reconciliationState"] },
      "then": { "properties": { "discrepancies": { "type": "array", "minItems": 1 }, "permittedAction": { "const": "QUARANTINE" } } }
    }
  ]
}
