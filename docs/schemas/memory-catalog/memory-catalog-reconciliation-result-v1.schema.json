{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shardwright:schema:v1:memory-catalog-reconciliation-result-v1",
  "title": "MemoryCatalogReconciliationResultV1",
  "description": "Diagnostic result comparing portable catalog authority with disposable catalog state. It cannot mutate authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope",
    "targetBoundary",
    "targetId",
    "reconciliationState",
    "authoritativeInputRefs",
    "observedProjectionRef",
    "discrepancies",
    "permittedAction",
    "authorityMutationPermitted",
    "reconciledAt"
  ],
  "properties": {
    "envelope": {
      "allOf": [
        {
          "$ref": "urn:shardwright:schema:v1:memory-artifact-envelope-v1"
        },
        {
          "type": "object",
          "properties": {
            "artifactClass": { "const": "RESULT" },
            "schemaId": { "const": "memory-catalog-reconciliation-result-v1" }
          },
          "required": ["artifactClass", "schemaId"]
        }
      ]
    },
    "targetBoundary": {
      "enum": ["CATALOG_RECORD", "CITATION_NAMESPACE", "CONTINUITY_TARGET", "CATALOG_SCOPE"]
    },
    "targetId": { "type": "string", "minLength": 1 },
    "reconciliationState": {
      "enum": [
        "CLEAN",
        "REBUILD_REQUIRED",
        "REGISTRATION_COMPLETION_REQUIRED",
        "AUTHORITY_MISSING",
        "CONFLICT",
        "QUARANTINED"
      ]
    },
    "authoritativeInputRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:shardwright:schema:v1:memory-artifact-reference-v1"
      }
    },
    "observedProjectionRef": {
      "anyOf": [
        { "type": "null" },
        {
          "allOf": [
            {
              "$ref": "urn:shardwright:schema:v1:memory-artifact-reference-v1"
            },
            {
              "type": "object",
              "properties": {
                "expectedArtifactClass": { "const": "PROJECTION" },
                "resolutionRequirement": { "const": "EXACT_HASH" }
              }
            }
          ]
        }
      ]
    },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message", "affectedRefs"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "severity": { "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"] },
          "message": { "type": "string", "minLength": 1 },
          "affectedRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "urn:shardwright:schema:v1:memory-artifact-reference-v1"
            }
          }
        }
      }
    },
    "permittedAction": {
      "enum": [
        "NONE",
        "REBUILD_PROJECTION",
        "COMPLETE_IDEMPOTENT_REGISTRATION",
        "REBUILD_INDEX",
        "QUARANTINE"
      ]
    },
    "authorityMutationPermitted": { "const": false },
    "reconciledAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "reconciliationState": { "const": "CLEAN" } },
        "required": ["reconciliationState"]
      },
      "then": {
        "properties": {
          "discrepancies": { "type": "array", "maxItems": 0 },
          "permittedAction": { "const": "NONE" }
        }
      }
    },
    {
      "if": {
        "properties": { "reconciliationState": { "const": "REBUILD_REQUIRED" } },
        "required": ["reconciliationState"]
      },
      "then": {
        "properties": {
          "authoritativeInputRefs": { "type": "array", "minItems": 1 },
          "permittedAction": { "enum": ["REBUILD_PROJECTION", "REBUILD_INDEX"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reconciliationState": {
            "enum": ["AUTHORITY_MISSING", "CONFLICT", "QUARANTINED"]
          }
        },
        "required": ["reconciliationState"]
      },
      "then": {
        "properties": {
          "discrepancies": { "type": "array", "minItems": 1 },
          "permittedAction": { "const": "QUARANTINE" }
        }
      }
    }
  ]
}
