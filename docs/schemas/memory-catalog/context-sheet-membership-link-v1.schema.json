{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shardwright:schema:v1:context-sheet-membership-link-v1",
  "title": "ContextSheetMembershipLinkV1",
  "description": "Immutable accepted claim-level relationship between one exact governed catalog record and one exact Context Sheet anchor revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope", "membershipLinkId", "catalogRecordRef", "catalogClaimIds",
    "contextSheetRef", "contextSheetLifecycleRef", "canonicalAnchorId", "linkType",
    "targetClaimIds", "claimBasisHash", "boundedMeaning", "limitations",
    "jurisdiction", "temporalApplicability", "antecedentState",
    "contradictionDimension", "validationState", "validationMethod",
    "governingPolicyVersion", "createdFromNominationRef", "validatedBy",
    "validatedAt", "validationEventRef", "supersedesLinkRef", "successorLinkRef",
    "currentUseState", "semanticDeduplicationKey", "evidenceAccountingKey",
    "catalogAuthorityCopied", "createsCatalogLifecycleAuthority", "createsDossierAuthority"
  ],
  "properties": {
    "envelope": {
      "allOf": [
        { "$ref": "urn:shardwright:schema:v1:memory-artifact-envelope-v1" },
        {
          "type": "object",
          "properties": {
            "artifactClass": { "const": "IMMUTABLE_RECORD" },
            "schemaId": { "const": "context-sheet-membership-link-v1" },
            "revision": { "const": 1 },
            "authorityBasisRefs": { "type": "array", "minItems": 1 }
          },
          "required": ["artifactClass", "schemaId", "revision", "authorityBasisRefs"]
        }
      ]
    },
    "membershipLinkId": { "type": "string", "pattern": "^membership-link:[A-Za-z0-9._~-]+$" },
    "catalogRecordRef": {
      "allOf": [
        { "$ref": "urn:shardwright:schema:v1:memory-artifact-reference-v1" },
        { "type": "object", "properties": { "artifactType": { "const": "memory-catalog-record-v1" }, "expectedArtifactClass": { "const": "AUTHORITY_REGISTRATION" }, "resolutionRequirement": { "const": "EXACT_HASH" } } }
      ]
    },
    "catalogClaimIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^claim:[A-Za-z0-9._~-]+$" } },
    "contextSheetRef": {
      "allOf": [
        { "$ref": "urn:shardwright:schema:v1:memory-artifact-reference-v1" },
        { "type": "object", "properties": { "artifactType": { "const": "context-sheet-record-v1" }, "expectedArtifactClass": { "const": "IMMUTABLE_RECORD" }, "resolutionRequirement": { "const": "EXACT_HASH" } } }
      ]
    },
    "contextSheetLifecycleRef": {
      "allOf": [
        { "$ref": "urn:shardwright:schema:v1:memory-artifact-reference-v1" },
        { "type": "object", "properties": { "artifactType": { "const": "context-sheet-lifecycle-projection-v1" }, "expectedArtifactClass": { "const": "PROJECTION" }, "resolutionRequirement": { "const": "EXACT_HASH" } } }
      ]
    },
    "canonicalAnchorId": { "type": "string", "pattern": "^canonical-anchor:[A-Za-z0-9._~-]+$" },
    "linkType": { "enum": ["DIRECT", "ATTRIBUTED", "INTERPRETIVE", "HISTORICAL", "CONTRADICTORY"] },
    "targetClaimIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^claim:[A-Za-z0-9._~-]+$" } },
    "claimBasisHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "boundedMeaning": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryScopeId", "jurisdictionId", "jurisdictionClass", "perspectiveId"],
      "properties": {
        "memoryScopeId": { "type": "string", "pattern": "^scope:[A-Za-z0-9._~-]+$" },
        "jurisdictionId": { "type": "string", "minLength": 1 },
        "jurisdictionClass": { "enum": ["SELF_SUBJECT", "SHARED_SUBJECT", "ARCHITECTURAL_OR_GOVERNANCE", "SHARED_WORLD", "EXTERNAL_WORLD", "PROJECT", "OTHER"] },
        "perspectiveId": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "temporalApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "validFrom", "validThrough"],
      "properties": {
        "state": { "enum": ["CURRENT", "HISTORICAL", "BOUNDED", "UNKNOWN"] },
        "validFrom": { "type": ["string", "null"], "format": "date-time" },
        "validThrough": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "antecedentState": { "type": ["string", "null"], "enum": ["RESOLVED", "UNRESOLVED", "UNAVAILABLE", "DISPUTED", null] },
    "contradictionDimension": { "type": ["string", "null"], "minLength": 1 },
    "validationState": { "const": "ACCEPTED" },
    "validationMethod": { "enum": ["DETERMINISTIC_CANONICAL_BINDING", "GOVERNED_CLAIM_BINDING", "HUMAN_ASSISTED_REVIEW"] },
    "governingPolicyVersion": { "type": "string", "minLength": 1 },
    "createdFromNominationRef": {
      "allOf": [
        { "$ref": "urn:shardwright:schema:v1:memory-artifact-reference-v1" },
        { "type": "object", "properties": { "artifactType": { "const": "context-sheet-membership-nomination-v1" }, "expectedArtifactClass": { "const": "NOMINATION" }, "resolutionRequirement": { "const": "EXACT_HASH" } } }
      ]
    },
    "validatedBy": {
      "type": "object", "additionalProperties": false, "required": ["owner", "componentId", "componentVersion"],
      "properties": { "owner": { "const": "MEMBERSHIP_LINK_SERVICE" }, "componentId": { "type": "string", "minLength": 1 }, "componentVersion": { "type": "string", "minLength": 1 } }
    },
    "validatedAt": { "type": "string", "format": "date-time" },
    "validationEventRef": {
      "allOf": [
        { "$ref": "urn:shardwright:schema:v1:memory-artifact-reference-v1" },
        { "type": "object", "properties": { "artifactType": { "const": "context-sheet-membership-validation-event-v1" }, "expectedArtifactClass": { "const": "EVENT" }, "resolutionRequirement": { "const": "EXACT_HASH" } } }
      ]
    },
    "supersedesLinkRef": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/exactMembershipLinkRef" }
      ]
    },
    "successorLinkRef": { "type": "null" },
    "currentUseState": { "const": "CURRENT" },
    "semanticDeduplicationKey": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidenceAccountingKey": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "catalogAuthorityCopied": { "const": false },
    "createsCatalogLifecycleAuthority": { "const": false },
    "createsDossierAuthority": { "const": false }
  },
  "$defs": {
    "exactMembershipLinkRef": {
      "allOf": [
        { "$ref": "urn:shardwright:schema:v1:memory-artifact-reference-v1" },
        { "type": "object", "properties": { "artifactType": { "const": "context-sheet-membership-link-v1" }, "expectedArtifactClass": { "const": "IMMUTABLE_RECORD" }, "resolutionRequirement": { "const": "EXACT_HASH" } } }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "linkType": { "const": "ATTRIBUTED" } }, "required": ["linkType"] },
      "then": { "properties": { "antecedentState": { "type": "string" } } },
      "else": { "properties": { "antecedentState": { "type": "null" } } }
    },
    {
      "if": { "properties": { "linkType": { "const": "CONTRADICTORY" } }, "required": ["linkType"] },
      "then": { "properties": { "targetClaimIds": { "type": "array", "minItems": 1 }, "contradictionDimension": { "type": "string" } } },
      "else": { "properties": { "contradictionDimension": { "type": "null" } } }
    },
    {
      "if": { "properties": { "linkType": { "const": "INTERPRETIVE" } }, "required": ["linkType"] },
      "then": { "properties": { "limitations": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "linkType": { "const": "HISTORICAL" } }, "required": ["linkType"] },
      "then": { "properties": { "temporalApplicability": { "type": "object", "properties": { "state": { "enum": ["HISTORICAL", "BOUNDED"] } } } } }
    }
  ]
}
